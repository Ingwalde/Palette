# Rendered at container start by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. Only CONNECT_SRC_EXTRA is substituted
# (NGINX_ENVSUBST_FILTER in the Dockerfile) so nginx's own $uri survives.
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Hashed, content-addressed Vite assets — safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: every non-asset path serves index.html so the client router can handle it.
    location / {
        add_header Cache-Control "no-store" always;

        # CSP for the built app: scripts/styles are same-origin hashed files ('self'); inline
        # style attributes (swatch colours) need 'unsafe-inline' for styles; Poppins is loaded
        # from Google Fonts. connect-src allows the Sentry ingest endpoints (the DSN's region
        # decides which one is used) — without them the browser blocks every error report and
        # Web Vital.
        #
        # CONNECT_SRC_EXTRA is empty in production, where the API is same-origin behind the
        # reverse proxy. docker-compose.yml sets it to the local dev API ports, because over
        # plain http the app talks to http://<hostname>:8000 (see src/lib/apiBase.ts).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io ${CONNECT_SRC_EXTRA}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

        try_files $uri /index.html;
    }
}
