# Backend security
# SECRET_KEY is MANDATORY. The app refuses to start if it is missing or left as
# a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-before-sharing
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auth tokens live in httpOnly cookies. COOKIE_SECURE must be true in production (https) so the
# browser only sends them over TLS; set it false for plain-http local development.
COOKIE_SECURE=false

# Application log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Rate-limit storage. Defaults to in-memory; Docker Compose sets redis://redis:6379 so
# limits are shared across processes/instances.
REDIS_URL=memory://

# Interactive API docs (Swagger UI / ReDoc). Off by default. Set true only for local
# development to expose /api/docs, /api/redoc and /api/openapi.json. Leave false/unset
# in production so the docs are not publicly reachable.
ENABLE_API_DOCS=false

# Allowed browser origins for CORS (comma-separated). Never use "*".
# In production add your public origin, e.g. https://palettes-app.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Email (Resend) — used for email verification and password-reset links. Without
# RESEND_API_KEY the app logs the link to the console instead of sending a real email
# (fine for local development). PUBLIC_BASE_URL builds the link and must point at the
# frontend origin. Password-reset links expire after PASSWORD_RESET_EXPIRE_HOURS (default 1).
RESEND_API_KEY=
EMAIL_FROM=Palette <noreply@palettes-app.com>
PUBLIC_BASE_URL=http://localhost:5500
# PASSWORD_RESET_EXPIRE_HOURS=1

# Database. PostgreSQL only — mandatory, no SQLite fallback. Docker Compose sets
# DATABASE_URL automatically from the values below (see docker-compose.yml). The app
# refuses to start without a postgresql:// URL.
#   DATABASE_URL=postgresql+psycopg://palette:palette@db:5432/palette

# PostgreSQL credentials (used by the db service and the Compose-generated DATABASE_URL)
POSTGRES_USER=palette
POSTGRES_PASSWORD=palette
POSTGRES_DB=palette

# First admin user created automatically if no admin exists yet
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@palette.local
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
